  "item": [
    {
      "name": "MoaIoTalk - Account and device APIs",
      "item": [
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"fcm_token\":\"{{fcmToken}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/odata/api/v1-Odata/account/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 200) {",
                "  const data = pm.response.json();",
                "  if (typeof data.token !== 'string' || !data.token) throw new Error('Login response has no token field.');",
                "  pm.collectionVariables.set('token', data.token);",
                "  console.log('Token saved to collection variable. Keep it private.');",
                "}"
              ]
            }
          }]
        },
        {
          "name": "register (creates account)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{username}}\",\"email\":\"\",\"first_name\":\"\",\"last_name\":\"\",\"job_title\":\"\",\"phone\":\"\",\"password\":\"{{password}}\",\"confirm_password\":\"{{password}}\",\"fcm_token\":\"{{fcmToken}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/odata/api/v1-Odata/account/register"
          },
          "description": "Creates an account. Supply valid registration fields before sending."
        },
        {
          "name": "deactivateAccount (destructive)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/odata/api/v1-Odata/account/deactivate"
          },
          "description": "Deactivates the authenticated account. Do not send unless you intend to deactivate it."
        },
        {
          "name": "account",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/odata/api/v1-Odata/account"
          }
        },
