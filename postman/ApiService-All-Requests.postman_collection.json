    {
      "name": "Camera control APIs",
      "description": "These requests target a camera URL supplied by the caller; they are not MoaIoTalk OData endpoints. Set cameraControlUrl and credentials only for a camera you are authorized to control.",
      "item": [
        {
          "name": "cameraControlGetByUrl",
          "request": {
            "method": "GET",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{cameraUsername}}", "type": "string" }, { "key": "password", "value": "{{cameraPassword}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json, */*" }],
            "url": "{{cameraControlUrl}}"
          }
        },
        {
          "name": "cameraMove (controls camera)",
          "request": {
            "method": "GET",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{cameraUsername}}", "type": "string" }, { "key": "password", "value": "{{cameraPassword}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json, */*" }],
            "url": "{{cameraControlUrl}}?move={{cameraMove}}&channel=0&stream=0"
          },
          "description": "Sends a PTZ move command to the configured camera control URL."
        },
        {
          "name": "cameraMove - ISAPI RTSP branch (controls camera)",
          "request": {
            "method": "PUT",
            "auth": { "type": "digest", "digest": [{ "key": "username", "value": "{{cameraUsername}}", "type": "string" }, { "key": "password", "value": "{{cameraPassword}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "*/*" }, { "key": "Content-Type", "value": "application/xml" }, { "key": "Connection", "value": "close" }],
            "body": { "mode": "raw", "raw": "<PTZData><pan>{{cameraPan}}</pan><tilt>{{cameraTilt}}</tilt><zoom>0</zoom></PTZData>", "options": { "raw": { "language": "xml" } } },
            "url": "http://{{cameraHost}}:{{cameraPort}}/ISAPI/PTZCtrl/channels/1/continuous"
          },
          "description": "RTSP-camera branch of cameraMove. The app first sends a warm-up GET before this PUT. Verify camera host, credentials, and PTZ values before sending."
        },
        {
          "name": "cameraZoom (controls camera)",
          "request": {
            "method": "GET",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{cameraUsername}}", "type": "string" }, { "key": "password", "value": "{{cameraPassword}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json, */*" }],
            "url": "{{cameraControlUrl}}?zoom={{cameraZoom}}&channel=0&stream=0"
          },
          "description": "Sends a zoom command to the configured camera control URL."
        },
        {
          "name": "cameraControlPutByUrl (controls camera)",
          "request": {
            "method": "PUT",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{cameraUsername}}", "type": "string" }, { "key": "password", "value": "{{cameraPassword}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "*/*" }, { "key": "Content-Type", "value": "application/xml" }],
            "body": { "mode": "raw", "raw": "<PTZData><pan>0</pan><tilt>0</tilt><zoom>0</zoom></PTZData>", "options": { "raw": { "language": "xml" } } },
            "url": "{{cameraControlUrl}}"
          },
          "description": "Sends a PTZ XML command to the configured camera URL. Verify the camera API's expected XML before sending."
        }
      ]
    }
  ]
